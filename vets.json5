<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Button Open DeepLink Example</title>
    <script>
        function openDeepLink() {
            let url ='store://enterprise/manifest?url=https://swxgch.chinaunicom.cn:8081/appversion/iosapp/harmony1_0_1/json5/LTBGHarmony.json5'
window.open(url, '_parent')        }
    </script>
</head>
<body>
<button onclick="openDeepLink()">下载</button>
</body>
</html>
